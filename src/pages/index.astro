---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <section
            aria-labelledby="game-filter-heading"
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            data-testid="game-filters"
          >
            <h3 id="game-filter-heading" class="mb-4 text-lg font-semibold text-slate-100">
              Filter games
            </h3>
            <div class="flex flex-col gap-6 lg:flex-row lg:items-end">
              <fieldset class="min-w-0 flex-1">
                <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
                <div class="flex flex-wrap gap-x-5 gap-y-3">
                  {categories.map((category) => (
                    <label class="inline-flex items-center gap-2 text-sm text-slate-300">
                      <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        data-testid="category-filter"
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800"
                      />
                      {category.name}
                    </label>
                  ))}
                </div>
              </fieldset>

              <div class="flex flex-col gap-2 lg:min-w-56">
                <label for="publisher-filter" class="text-sm font-medium text-slate-200">
                  Publisher
                </label>
                <select
                  id="publisher-filter"
                  data-testid="publisher-filter"
                  class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                >
                  <option value="">All publishers</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>

              <button
                type="button"
                data-testid="clear-game-filters"
                class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                Clear filters
              </button>
            </div>
          </section>

          <p
            class="mb-4 text-sm text-slate-400"
            role="status"
            aria-live="polite"
            data-testid="filter-results-count"
          >
            Showing {games.length} games
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-game-filters"]');

  if (filters && gamesGrid && resultsCount && clearButton) {
    const categoryInputs = Array.from(
      filters.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherSelect = filters.querySelector<HTMLSelectElement>('#publisher-filter');
    const gameCards = Array.from(gamesGrid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    /** Applies the selected filters to the prerendered game cards. */
    const updateVisibleGames = (): void => {
      const selectedCategoryIds = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const publisherId = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategoryIds.size === 0 || selectedCategoryIds.has(card.dataset.gameCategoryId ?? '');
        const publisherMatches =
          publisherId === '' || card.dataset.gamePublisherId === publisherId;
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      }

      resultsCount.textContent =
        visibleCount === 0
          ? 'No games match the selected filters.'
          : `Showing ${visibleCount} of ${gameCards.length} games`;
    };

    filters.addEventListener('change', updateVisibleGames);
    clearButton.addEventListener('click', () => {
      for (const input of categoryInputs) input.checked = false;
      if (publisherSelect) publisherSelect.value = '';
      updateVisibleGames();
    });
  }
</script>
